<?xml version="1.0" encoding="UTF-8"?>
<project>
    <parent>
        <groupId>com.example</groupId>
        <artifactId>gwt-test</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>client</artifactId>
    <packaging>gwt-app</packaging> <!-- Важно: gwt-app -->

    <dependencies>
        <!-- 1. Бинарный JAR общего модуля (для стандартного компилятора) -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>shared</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 2. Исходники общего модуля (для GWT-транслятора) -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>shared</artifactId>
            <version>${project.version}</version>
            <classifier>sources</classifier>
        </dependency>

        <!-- 1. Бинарный JAR общего модуля (для стандартного компилятора) -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>models</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 2. Исходники общего модуля (для GWT-транслятора) -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>models</artifactId>
            <version>${project.version}</version>
            <classifier>sources</classifier>
        </dependency>

        <!-- 3. Библиотека gwt-user -->
        <dependency>
            <groupId>org.gwtproject</groupId>
            <artifactId>gwt-user</artifactId>
            <version>${gwt.version}</version>
        </dependency>

        <!-- 4. ИСПРАВЛЕНО: Убран <scope>provided</scope>, чтобы CodeServer мог запуститься -->
        <dependency>
            <groupId>org.gwtproject</groupId>
            <artifactId>gwt-dev</artifactId>
            <version>${gwt.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>net.ltgt.gwt.maven</groupId>
                <artifactId>gwt-maven-plugin</artifactId>
                <version>${gwt.plugin.version}</version>
                <extensions>true</extensions>
                <configuration>
                    <moduleName>com.example.client.Smart</moduleName>
                    <moduleShortName>smart</moduleShortName>
<!--                    <launcherDir>${project.build.directory}/gwt/launcherDir</launcherDir>-->
                    <launcherDir>${project.build.directory}/${project.build.finalName}</launcherDir>v
                    <!--<codeserverArgs>
                        <arg>-allowMissingSrc</arg>
                    </codeserverArgs>-->
                    <startupUrls>
                        <startupUrl>http://127.0.0.1:8080/index.html</startupUrl>
                    </startupUrls>
                    <codeserverArgs>
                        <arg>-allowMissingSrc</arg> <!-- Игнорировать отсутствие исходников некоторых библиотек -->
                        <arg>-bindAddress</arg>
                        <arg>0.0.0.0</arg> <!-- Слушать внешние порты -->
                    </codeserverArgs>
                    <compilerArgs>
                        <arg>-optimize</arg>
                        <arg>9</arg>
                    </compilerArgs>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>