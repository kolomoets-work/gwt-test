<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC "-//Google Inc.//DTD GWT 2.11.0//EN" "http://gwtproject.org/doctype/2.11.0/gwt-module.dtd">
<module rename-to="smart">
    <inherits name='com.google.gwt.user.User'/>
    <inherits name='com.google.gwt.user.theme.clean.Clean'/>
    <inherits name='com.example.shared.SharedMarker'/>
    <inherits name='com.example.shared.models'/>
    <entry-point class='com.example.client.Smart'/>
    <source path=''/>


    <!-- Modern Configuration for GWT 2.13.1 & Java 21 -->
    <add-linker name="xsiframe"/>
    <set-configuration-property name="devModeRedirectEnabled" value="true"/>
</module>
